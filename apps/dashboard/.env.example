# TrafficPulse Dashboard Environment Configuration

PORT=3000
NODE_ENV=development

# Database URL
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trafficpulse?schema=public"

# Authentication & Admin
# REQUIRED. Generate with: openssl rand -hex 32  (the app refuses to start auth with the placeholder)
ADMIN_API_KEY="change_this_generate_with_openssl_rand_hex_32"

# Observability
METRICS_AUTH_TOKEN="change_this_generate_with_openssl_rand_hex_32"
METRICS_PUBLIC=false

# Security
TRUST_PROXY=false
# REDIS_URL="redis://localhost:6379"

# Lifecycle
RETENTION_DAYS=90
NEXT_PUBLIC_API_HOST="http://localhost:3000"
