# TrafficPulse Environment Configuration

# Server & Runtime
PORT=3000
NODE_ENV=development

# Database URL
# Local SQLite development (default):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trafficpulse?schema=public"

# Authentication & Admin Access
ADMIN_API_KEY="tp_admin_change_this_to_a_secure_random_key_in_production"
NEXTAUTH_SECRET="change_this_random_32_byte_secret_key"

# Observability & Metrics
METRICS_AUTH_TOKEN="tp_metrics_secret_token"
METRICS_PUBLIC=false

# Security & Proxy Trust
# Set to true ONLY when deployed behind a trusted reverse proxy (Nginx, Cloudflare, Traefik, AWS ALB)
TRUST_PROXY=false

# Rate Limiting Store
# In-memory token bucket used if omitted. Configure Redis for multi-instance distributed deployments:
# REDIS_URL="redis://localhost:6379"

# Data Lifecycle & Retention (in days)
RETENTION_DAYS=90

# Public API host for client beacons (defaults to origin if omitted)
NEXT_PUBLIC_API_HOST="http://localhost:3000"

# Docker Compose (required by docker-compose.yml)
POSTGRES_PASSWORD="change_me_strong_password"
# Salt for API key hashing. Set once before creating sites; changing it later invalidates existing keys.
API_KEY_SALT="change_me_random_salt"
