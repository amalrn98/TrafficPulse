# TrafficPulse Environment Configuration

# Server & Runtime
PORT=3000
NODE_ENV=development

# Postgres password for docker compose (REQUIRED). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=change_this_generate_with_openssl_rand_hex_24

# Database URL
# Local SQLite development (default):
DATABASE_URL="file:./dev.db"
# Production PostgreSQL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trafficpulse?schema=public"

# Authentication & Admin Access
# REQUIRED. Generate with: openssl rand -hex 32  (the app refuses to start auth with the placeholder)
ADMIN_API_KEY="change_this_generate_with_openssl_rand_hex_32"

# Observability & Metrics
METRICS_AUTH_TOKEN="change_this_generate_with_openssl_rand_hex_32"
METRICS_PUBLIC=false

# Security & Proxy Trust
# Set to true ONLY when deployed behind a trusted reverse proxy (Nginx, Cloudflare, Traefik, AWS ALB)
TRUST_PROXY=false
# Number of trusted proxies in front of the app (X-Forwarded-For entries counted from the right)
# TRUSTED_PROXY_HOPS=1
# Require an API key for all ingestion (disables keyless browser beacons)
# REQUIRE_API_KEY=false
# Optional: set a random secret before creating sites so key hashes are not derived from the public default salt
# API_KEY_SALT=

# Rate Limiting Store
# In-memory token bucket used if omitted. Configure Redis for multi-instance distributed deployments:
# REDIS_URL="redis://localhost:6379"

# Data Lifecycle & Retention (in days)
RETENTION_DAYS=90

# Public API host for client beacons (defaults to origin if omitted)
NEXT_PUBLIC_API_HOST="http://localhost:3000"
