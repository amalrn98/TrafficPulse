# TrafficPulse Environment Configuration

# Dashboard port
PORT=3000
NODE_ENV=development

# Database URL (Default: SQLite local database file)
DATABASE_URL="file:./dev.db"

# Optional: To use PostgreSQL, set:
# DATABASE_URL="postgresql://user:password@localhost:5432/trafficpulse?schema=public"

# Public API host for client beacons (Defaults to current origin if omitted)
NEXT_PUBLIC_API_HOST="http://localhost:3000"

# Optional GitHub OAuth Configuration (NextAuth)
# GITHUB_ID="your_github_client_id"
# GITHUB_SECRET="your_github_client_secret"
# NEXTAUTH_SECRET="your_nextauth_secret_key"
